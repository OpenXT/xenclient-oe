 #define PCI_DEVICE_ID_XEN_PLATFORM  0x0001
+#define PCI_DEVICE_ID_XEN_PLATFORM_XS    0x0002
 
 /**
 
@@ -96,7 +97,8 @@
 
   if (Status == EFI_SUCCESS) {
