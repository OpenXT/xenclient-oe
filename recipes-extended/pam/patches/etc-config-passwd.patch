OpenXT: point pam_unix passwd/shadow at /config/etc

OpenXT keeps /etc/passwd and /etc/shadow on a writable overlay under
/config/etc because the rootfs is read-only. Redirect pam_unix lock,
verify, and update paths accordingly.

Upstream-Status: Inappropriate [OpenXT read-only rootfs]

diff -urN a/modules/pam_unix/lckpwdf.-c b/modules/pam_unix/lckpwdf.-c
--- a/modules/pam_unix/lckpwdf.-c	2026-09-10 10:59:24.783752466 -0400
+++ b/modules/pam_unix/lckpwdf.-c	2026-09-10 10:59:24.783752466 -0400
@@ -30,7 +30,7 @@
 #include <selinux/selinux.h>
 #endif
 
-#define LOCKFILE "/etc/.pwd.lock"
+#define LOCKFILE "/config/etc/.pwd.lock"
 #define TIMEOUT 15
 
 static int lockfd = -1;
@@ -67,7 +67,7 @@
 			char *create_context_raw;
 			int rc;
 
-			if(getfilecon_raw("/etc/passwd", &create_context_raw))
+			if(getfilecon_raw("/config/etc/passwd", &create_context_raw))
 				return -1;
 			rc = setfscreatecon_raw(create_context_raw);
 			freecon(create_context_raw);
